# ESPHome Secrets Template
# Copy this file to secrets.yaml and fill in your actual values
# This template can be safely committed to version control

# Wi-Fi Configuration
wifi_ssid: "YOUR_WIFI_SSID_HERE"
wifi_password: "YOUR_WIFI_PASSWORD_HERE"

# Fallback Access Point Configuration
fallback_ap_password: "CHANGE_THIS_PASSWORD"

# Home Assistant API Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
api_encryption_key: "YOUR_32_CHARACTER_HEX_KEY_HERE"

# OTA (Over The Air) Update Configuration
ota_password: "YOUR_OTA_UPDATE_PASSWORD_HERE"
