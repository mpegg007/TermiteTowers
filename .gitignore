# Python
__pycache__/
*.pyc
.venv/
venv/
.tox/

# Node
node_modules/

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.history/

# Logs & tmp
*.log
tmp/
.cache/

# Build/dist
dist/
build/

# Local envs
.env
.env.*.local
secrets/*.json
env/*.env

infra/docker/env/*.env
.cache_ggshield
infra/docker/env/*_password.txt
hams/esphome/.esphome
# Test artifacts
tests/**/results.xml

# Local inventories and captures that carry credentials, device keys or tokens
# (e.g. Tuya localKey values, DHCP syslogs, MCP config tokens). The .example /
# template equivalents stay trackable; the live files must never be committed.
hams/inventory/tuyacloud_devices.json
hams/inventory/network_devices-*.csv
hams/inventory/dhcp.syslog*
infra/mcp/home-assistant/mcp-config.json
trigger-test.env
/config.json
/client_secret.json

# tt-backup: age private identities must never be committed. The live identity
# lives outside the repo (~/.config/age/) and is also deliberately kept OFF
# /mnt/ai_storage so jottad cannot upload it next to the backups it protects.
# These patterns are defence-in-depth against an accidental copy into the tree.
*.age-identity
age-identity*.txt
age-key*.txt
tthealth-backup.txt

# tt-keys: the master identity, its escrow copies and the wrapped keyring.
# NOTE: master-recipient.txt (PUBLIC) must stay committed - the patterns below
# are deliberately narrow enough not to match it.
master.txt
master-identity*.txt
master.escrow.age
*.escrow.age
keyring.tar.age
keyring.tar.age.tmp*

