#  TermiteTowers Continuous Code Management Header TEMPLATE --- %ccm_git_header_end:  %  
# %git_commit_history: november changes % 
# TermiteTowers bash initialization
# Supports both development (~/source) and production (/srv) deployments

# Debug tracing support (set tt_debug=1 to enable)
tt_tracelogDir=${tt_tracelogDir:-$HOME/tmp}
if [ ! -z ${tt_debug} ]; then
  mkdir -p "$tt_tracelogDir"
  tt_tracelog="${tt_tracelogDir}/profile-trace.log.$$"
  set > "${tt_tracelogDir}/profile-start.setInfo.$$"
  echo "$(date '+%F %T') - Profile initialization started (PID: $$)" >> "$tt_tracelog"
else
  tt_tracelog=/dev/null
fi

# Determine script directory
if [ -n "${BASH_SOURCE[0]}" ]; then
  tt_profiledir=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
else
  tt_profiledir=$(pwd)
fi
export tt_profiledir

[ ! -z ${tt_debug} ] && echo "tt_profiledir=$tt_profiledir" >> "$tt_tracelog"

# Set environment defaults
tt_scmID=${tt_scmID:-dev1}
tt_appID=${tt_appID:-util}
tt_regionID=${tt_regionID:-${tt_scmID:0:3}}
export tt_scmID tt_appID tt_regionID

[ ! -z ${tt_debug} ] && echo "tt_scmID=$tt_scmID tt_appID=$tt_appID tt_regionID=$tt_regionID" >> "$tt_tracelog"

# Determine util directory location
# Priority: 1) /srv/<scmID>/util/  2) same dir as profile.tt
if [ -d "/srv/${tt_scmID}/util" ]; then
  tt_utilDir="/srv/${tt_scmID}/util"
elif [ -d "${tt_profiledir}/util" ]; then
  tt_utilDir="${tt_profiledir}/util"
else
  # Fallback: no util scripts available
  tt_utilDir=""
fi
export tt_utilDir

[ ! -z ${tt_debug} ] && echo "tt_utilDir=$tt_utilDir" >> "$tt_tracelog"

# Source util scripts if available
if [ -n "$tt_utilDir" ] && [ -d "$tt_utilDir" ]; then
  for script in initENV.sh initHistory.sh initAliases.sh initPrompt.sh; do
    if [ -f "$tt_utilDir/$script" ]; then
      [ ! -z ${tt_debug} ] && echo "Sourcing $tt_utilDir/$script" >> "$tt_tracelog"
      . "$tt_utilDir/$script"
    fi
  done
fi

# Debug: capture end state
if [ ! -z ${tt_debug} ]; then
  set > "${tt_tracelogDir}/profile-end.setInfo.$$"
  echo "$(date '+%F %T') - Profile initialization completed (PID: $$)" >> "$tt_tracelog"
fi