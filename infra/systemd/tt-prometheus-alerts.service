# Deliver firing Prometheus alerts by mail via ttmail.
#
# Alertmanager is deliberately not deployed: this is the whole delivery layer.
# See scripts/tt-prometheus-alerts.sh for the reasoning and the dedup behaviour.
#
# Install (one time):
#   sudo install -m 0644 infra/systemd/tt-prometheus-alerts.service /etc/systemd/system/
#   sudo install -m 0644 infra/systemd/tt-prometheus-alerts.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tt-prometheus-alerts.timer
#
# The EnvironmentFile is NOT in the repo and must be created from secrets:
#   /etc/tt-secrets/dev1/env/prometheus-alerts.env
#     ALERT_TO=you@example.com
#     # optional: TTMAIL_BIN=/path/to/ttmail
#   sudo chmod 0640 .../prometheus-alerts.env
[Unit]
Description=tt-prometheus alert delivery (Prometheus ALERTS to mail via ttmail)
Documentation=file:/home/mpegg-adm/source/TermiteTowers/wiki/runbook-prometheus.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mpegg-adm
Group=mpegg-adm

# ALERT_TO comes from here. A missing file makes systemd fail the unit rather
# than run with an empty recipient, which the script also refuses.
EnvironmentFile=/etc/tt-secrets/dev1/env/prometheus-alerts.env

ExecStart=/home/mpegg-adm/source/TermiteTowers/scripts/tt-prometheus-alerts.sh

# Alert state: /var/lib/tt-prometheus/alerts.state, created and owned by this
# unit. Not backed up on purpose - losing it costs at most one duplicate mail.
StateDirectory=tt-prometheus
StateDirectoryMode=0750

TimeoutStartSec=2min
Nice=10
IOSchedulingClass=idle

# Read-only host, writable only where the unit declares it. The script needs the
# repo (read), the ttmail env file (read) and its state directory (write).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
UMask=0027
