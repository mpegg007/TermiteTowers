[Unit]
Description=Archive Uptime Kuma history into Postgres nightly at 05:15

[Timer]
# 05:15 local. Deliberately clear of tt-backup-tthealth (03:30 + 10m jitter) and
# tt-backup-mail (04:30), so the archive never competes with a backup for disk.
OnCalendar=*-*-* 05:15:00

# A host that was off at 05:15 still catches up. Combined with Persistent=true
# this also replays a missed run after downtime.
OnBootSec=10min
Persistent=true

AccuracySec=1min
Unit=tt-monitor-archive.service

[Install]
WantedBy=timers.target
