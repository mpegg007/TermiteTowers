[Unit]
Description=tt-keys audit: key generations vs artifacts on disk
Documentation=file:/home/mpegg-adm/source/TermiteTowers/infra/backups/README.md
After=network-online.target

[Service]
Type=oneshot
User=mpegg-adm
Group=mpegg-adm
ExecStart=/home/mpegg-adm/source/TermiteTowers/infra/backups/scripts/tt-keys.sh audit
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle

# Read-only by construction: audit needs the registry and the artifact trees and
# nothing else. No secrets are involved (the master identity is never used here).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/mnt/ai_storage/backups
UMask=0027
