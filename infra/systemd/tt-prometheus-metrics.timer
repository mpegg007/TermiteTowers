[Unit]
Description=Publish backup freshness metrics every 15 minutes

[Timer]
OnBootSec=3min
# 15 minutes is far finer than the 26h staleness threshold needs. The point is
# that the heartbeat metric goes stale quickly if the emitter itself breaks,
# rather than only when a backup is missed.
OnUnitActiveSec=15min
AccuracySec=1min

# Persistent: after downtime, run once immediately so the metrics are current
# rather than up to 15 minutes stale.
Persistent=true

[Install]
WantedBy=timers.target
