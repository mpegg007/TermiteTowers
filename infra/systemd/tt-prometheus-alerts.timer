[Unit]
Description=Check Prometheus alerts every 5 minutes and mail on change

[Timer]
# OnBootSec so a reboot does not delay the first check, and OnUnitActiveSec for
# a fixed interval that does not drift with how long a run takes.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

# Not Persistent: a missed run while the host was down is not worth replaying -
# the alerts are still firing, so the next run notifies anyway.
Persistent=false

[Install]
WantedBy=timers.target
