# Runs after tt-backup-tthealth (03:30 + jitter) and before the mail archive
# (04:30), so the three jobs never compete for disk on the same pool.
[Unit]
Description=Daily encrypted dump of ttdb_dev1

[Timer]
OnCalendar=*-*-* 03:50:00
RandomizedDelaySec=10m
# A host that was off at 03:50 still takes the backup on the next boot.
Persistent=true

[Install]
WantedBy=timers.target
