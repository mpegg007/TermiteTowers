[Unit]
Description=Daily encrypted Thunderbird mail archive

[Timer]
# 04:30, after the tthealth DB backup window. A run that finds every completed
# period already archived exits without writing anything.
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=15m
AccuracySec=1m
Persistent=true

[Install]
WantedBy=timers.target
