[Unit]
Description=Encrypted Thunderbird mail archive (immutable per-month chunks)
Documentation=file:@REPO_DIR@/infra/backups/README.md

[Service]
Type=oneshot
# Runs as the invoking user - no sudo, no service account.
#
# Hybrid layout. The per-year chunks sealed before the switch (2018-2025) are
# left exactly as they are: a month run only ever looks at month periods, so
# the legacy years are inert. From 2026-01 on every month is sealed once and
# kept; the month still in progress is re-cut nightly, so newest mail is never
# more than about a day away from the archive.
#
#  --since 2026-01     keep the loop off the legacy years
#  --include-current   refresh the month in progress (also seals last month on
#                      the first run after a rollover, because its name changed)
#  --max-periods 2     a rollover night does the closing month AND the new one
#  --scan              tell jottad to look now instead of at its next hourly pass
ExecStart=@REPO_DIR@/infra/backups/scripts/backup-mail.py \
    --granularity month --since 2026-01 --include-current --max-periods 2 --scan
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
