[Unit]
Description=Encrypted Thunderbird mail archive (immutable per-year chunks)
Documentation=file:@REPO_DIR@/infra/backups/README.md

[Service]
Type=oneshot
# Runs as the invoking user - no sudo, no service account. A completed year is
# archived once; later runs only re-read the mboxes to prove nothing changed.
ExecStart=@REPO_DIR@/infra/backups/scripts/backup-mail.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
