# Encrypted dump of ttdb_dev1 as the invoking user (peer auth, no password).
#
# User unit on purpose: infra/backups/scripts/backup-db-user.sh needs no root,
# no service account and no pgpass, so the whole job installs with
# install-tt-backup-db-user.sh rather than a sudo deploy. Same shape as
# tt-backup-mail.service.
[Unit]
Description=tt-backup :: encrypted pg_dump of ttdb_dev1
Documentation=file:@REPO_DIR@/infra/backups/README.md
After=network-online.target

[Service]
Type=oneshot
Environment=APP_NAME=ttdb
Environment=DB_NAME=ttdb_dev1
Environment=AGE_TIER=general
# Every schema the dump must contain. If one is missing the job FAILS rather
# than publishing a partial backup. nextcloud is deliberately absent: it has
# no USAGE grant and may be empty, so asserting it would be a false alarm.
# monitoring holds the Uptime Kuma availability archive, which is the only copy
# of that history once Kuma prunes past keepDataPeriodDays. Asserting it here
# means a dump that silently omitted the schema fails instead of looking clean.
Environment=EXPECT_SCHEMAS=dhcp_history,kea,monitoring,powerdns,snipeit,water_meter,watchyourlan
Environment=RETENTION_DAYS=14
ExecStart=@REPO_DIR@/infra/backups/scripts/backup-db-user.sh

Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
