# Encrypted dump of ttphoto_dev1 as the invoking user (peer auth, no password).
#
# ttphoto_dev1 is the photo archive's metadata: 18,835 image records plus
# ~3.5 M tag rows. Tagging is human work, so unlike the monitoring archive
# there is no regeneration window - this runs daily.
[Unit]
Description=tt-backup :: encrypted pg_dump of ttphoto_dev1
Documentation=file:@REPO_DIR@/infra/backups/README.md
After=network-online.target

[Service]
Type=oneshot
Environment=APP_NAME=ttphoto
Environment=DB_NAME=ttphoto_dev1
Environment=AGE_TIER=general
# public carries the pre-v2 tables and v2 the current schema. Assert both: the
# read-only MCP account cannot even SEE v2, which is exactly how a dump could
# look successful while omitting the schema that matters going forward.
Environment=EXPECT_SCHEMAS=public,v2
Environment=RETENTION_DAYS=14
ExecStart=@REPO_DIR@/infra/backups/scripts/backup-db-user.sh

Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
