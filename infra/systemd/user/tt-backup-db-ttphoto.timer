# Daily, after ttdb so the two do not overlap. Measured first dump: 53 MB in
# about 5 seconds, so it is cheap and there is no reason to stretch the gap.
[Unit]
Description=Daily encrypted dump of ttphoto_dev1

[Timer]
OnCalendar=*-*-* 04:10:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
