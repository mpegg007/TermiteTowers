# Publish backup freshness into the node-exporter textfile directory.
#
# Reads the backup tree and writes one .prom file. No database access, no age
# key, no docker - group read on backups and write on the textfile directory is
# the whole requirement, so it runs as the normal user rather than as tt-backup.
#
# Install (one time):
#   sudo install -m 0644 infra/systemd/tt-prometheus-metrics.service /etc/systemd/system/
#   sudo install -m 0644 infra/systemd/tt-prometheus-metrics.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tt-prometheus-metrics.timer
[Unit]
Description=tt-prometheus backup freshness metrics (textfile collector)
Documentation=file:/home/mpegg-adm/source/TermiteTowers/wiki/runbook-prometheus.md
After=local-fs.target

[Service]
Type=oneshot
User=mpegg-adm
Group=mpegg-adm
ExecStart=/home/mpegg-adm/source/TermiteTowers/scripts/emit-backup-metrics.sh

TimeoutStartSec=2min
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

# The only two paths that matter: read the backups, write the metric file.
ReadOnlyPaths=/mnt/ai_storage/backups
ReadWritePaths=/mnt/ai_storage/prometheus/textfile

UMask=0022
