[Unit]
Description=Weekly tt-keys audit (generation vs artifact inventory)

[Timer]
OnCalendar=Mon *-*-* 07:17:00
RandomizedDelaySec=10m
AccuracySec=1m
Persistent=true

[Install]
WantedBy=timers.target
