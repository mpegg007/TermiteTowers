[
  {"process": "rsyslogd", "subproc": "rsyslogd", "action": "drop"},
  {"process": "kernel", "subproc": "bios-e820", "action": "drop"},
  {"process": "kernel", "subproc": "*", "action": "filename", "filename": "{root}/{server}/pend/journal-kernel.txt"},
  {"process_regex": "^gnome.*", "subproc": "*", "action": "filename", "filename": "{root}/{server}/pend/journal-gnome.txt"},
  {"process_regex": "^xdgd.*", "subproc": "*", "action": "filename", "filename": "{root}/{server}/pend/journal-xdgd.txt"},
  {"process": "*", "subproc": "*", "action": "filename", "filename": "{root}/{server}/pend/journal-{proc}.txt"}
]