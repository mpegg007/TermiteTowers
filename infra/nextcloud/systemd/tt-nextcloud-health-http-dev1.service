[Unit]
Description=Nextcloud Health Check HTTP Endpoint (dev1)
Documentation=file:///home/mpegg-adm/source/TermiteTowers/infra/nextcloud/scripts/monitoring/tt-nextcloud-health-http-dev1.py
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=mpegg-adm
Group=mpegg-adm
# Paths point at the git-deployed dev1 tree — not at a human working copy, and
# not at a hand-made per-service directory like /srv/dev1/nextcloud/. That tree
# is an rsync target refreshed by .github/workflows/deploy-dev1.yml, so what runs
# here is exactly what was committed to branch dev1. The prod equivalent will be
# /srv/prd/tt/... if this is ever promoted.
WorkingDirectory=/srv/dev1/tt/infra/nextcloud/scripts/monitoring
# Bind to the host side of monitor-apps-net-dev1 (Kuma's network) rather than
# 127.0.0.1: Uptime Kuma runs in a container and cannot reach host loopback, and
# there is no host-gateway entry on its compose. This address is reachable by the
# Kuma container and not by the LAN.
Environment=NC_HEALTH_BIND=10.10.64.1
Environment=NC_HEALTH_PORT=9002
ExecStart=/usr/bin/python3 /srv/dev1/tt/infra/nextcloud/scripts/monitoring/tt-nextcloud-health-http-dev1.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
