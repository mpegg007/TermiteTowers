[Unit]
Description=Nextcloud Health Check HTTP Endpoint (dev1)
Documentation=file:///home/mpegg-adm/source/TermiteTowers/infra/nextcloud/scripts/monitoring/tt-nextcloud-health-http-dev1.py
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=mpegg-adm
Group=mpegg-adm
# Paths point at the working copy on purpose. The target layout is that
# /srv/dev1/tt and /srv/prd/tt are both git-managed trees (dev1 auto-deployed
# from git, prd from git, this working copy remains the place edits start), so a
# unit should reference the deployed tree rather than a hand-made per-service
# directory like /srv/dev1/nextcloud/. When that consolidation lands, this is a
# one-line repoint to /srv/dev1/tt/infra/nextcloud/scripts/monitoring.
WorkingDirectory=/home/mpegg-adm/source/TermiteTowers/infra/nextcloud/scripts/monitoring
# Bind to the host side of monitor-apps-net-dev1 (Kuma's network) rather than
# 127.0.0.1: Uptime Kuma runs in a container and cannot reach host loopback, and
# there is no host-gateway entry on its compose. This address is reachable by the
# Kuma container and not by the LAN.
Environment=NC_HEALTH_BIND=10.10.64.1
Environment=NC_HEALTH_PORT=9002
ExecStart=/usr/bin/python3 /home/mpegg-adm/source/TermiteTowers/infra/nextcloud/scripts/monitoring/tt-nextcloud-health-http-dev1.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
