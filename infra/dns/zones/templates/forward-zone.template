;
; DNS Zone Template for Forward Lookup
; Domain: {{DOMAIN_NAME}}
; Generated: {{GENERATION_DATE}}
;

$TTL {{DEFAULT_TTL}}
@       IN      SOA     {{PRIMARY_NS}}. {{ADMIN_EMAIL}}. (
                        {{SERIAL}}      ; Serial number
                        {{REFRESH}}     ; Refresh
                        {{RETRY}}       ; Retry
                        {{EXPIRE}}      ; Expire
                        {{MIN_TTL}}     ; Minimum TTL
                        )

; Name servers
@       IN      NS      {{PRIMARY_NS}}.
{% for ns in SECONDARY_NS %}
@       IN      NS      {{ns}}.
{% endfor %}

; Mail servers
{% for mx in MX_RECORDS %}
@       IN      MX      {{mx.priority}}     {{mx.server}}.
{% endfor %}

; A Records
{% for record in A_RECORDS %}
{{record.name}}     IN      A       {{record.ip}}
{% endfor %}

; AAAA Records (IPv6)
{% for record in AAAA_RECORDS %}
{{record.name}}     IN      AAAA    {{record.ipv6}}
{% endfor %}

; CNAME Records
{% for record in CNAME_RECORDS %}
{{record.name}}     IN      CNAME   {{record.target}}.
{% endfor %}

; TXT Records
{% for record in TXT_RECORDS %}
{{record.name}}     IN      TXT     "{{record.text}}"
{% endfor %}

; SRV Records
{% for record in SRV_RECORDS %}
{{record.name}}     IN      SRV     {{record.priority}} {{record.weight}} {{record.port}} {{record.target}}.
{% endfor %}
