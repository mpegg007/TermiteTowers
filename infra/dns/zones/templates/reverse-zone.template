;
; Reverse DNS Zone Template
; Network: {{NETWORK}}
; Generated: {{GENERATION_DATE}}
;

$TTL {{DEFAULT_TTL}}
@       IN      SOA     {{PRIMARY_NS}}. {{ADMIN_EMAIL}}. (
                        {{SERIAL}}      ; Serial number
                        {{REFRESH}}     ; Refresh
                        {{RETRY}}       ; Retry
                        {{EXPIRE}}      ; Expire
                        {{MIN_TTL}}     ; Minimum TTL
                        )

; Name servers
@       IN      NS      {{PRIMARY_NS}}.
{% for ns in SECONDARY_NS %}
@       IN      NS      {{ns}}.
{% endfor %}

; PTR Records
{% for record in PTR_RECORDS %}
{{record.octet}}    IN      PTR     {{record.hostname}}.{{record.domain}}.
{% endfor %}
