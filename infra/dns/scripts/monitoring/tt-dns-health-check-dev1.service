[Unit]
Description=DNS Health Check (dev1)
After=network.target docker.service

[Service]
Type=oneshot
User=root
# Runs from the git-deployed dev1 tree, not from a human working copy. The tree
# is refreshed by .github/workflows/deploy-dev1.yml on every push to dev1.
ExecStart=/srv/dev1/tt/infra/dns/scripts/monitoring/tt-dns-health-check-dev1.sh

[Install]
WantedBy=multi-user.target
