# .env.example for Nextcloud
# Copy to nextcloud.env and fill in secrets. nextcloud.env is gitignored.
#
# Database: its own database "nextcloud", owned by role "nextcloud", on the host
# cluster (PostgreSQL 16). There is deliberately no POSTGRES_SCHEMA key —
# Nextcloud has no db_schema setting and cannot target a schema.
#
# Authentication is scram-sha-256 on this cluster, and the container reaches the
# host as host.docker.internal = 172.17.0.1 (docker0), NOT the app-network
# gateway. Any pg_hba rule for it must be written for 172.17.0.0/16 and must say
# scram-sha-256; an md5 rule cannot authenticate a scram-stored password.
#
# The public hostname is filebank.analacres.ca. The old termitetowers name is
# kept in trusted domains only so the redirect target still validates.

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# User data location inside the container. Mounted from the gallery array.
NEXTCLOUD_DATA_DIR=/var/www/html/data

# Nextcloud admin credentials, consumed only on first install
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Trusted domains (space-separated)
NEXTCLOUD_TRUSTED_DOMAINS=filebank.analacres.ca nextcloud.termitetowers.ca localhost

TZ=UTC
