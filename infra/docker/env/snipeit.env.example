# Copy to snipeit.env and configure your Snipe-IT settings
# Generate APP_KEY with: docker run --rm snipe/snipe-it:latest php artisan key:generate --show

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://snipeit.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en

# Database Settings (handled by secrets in docker-compose)
DB_CONNECTION=mysql
DB_HOST=snipeit-db
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit
# DB_PASSWORD is set via secrets

MYSQL_DATABASE=snipeit
MYSQL_USER=snipeit

# Mail Settings
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDR=
MAIL_FROM_NAME="Snipe-IT"

# Session Settings
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_DRIVER=sync

# Other Settings
LOG_CHANNEL=single
