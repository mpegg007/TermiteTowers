# Copy to snipeit.env and configure your Snipe-IT settings
# Generate APP_KEY with: docker run --rm snipe/snipe-it:latest php artisan key:generate --show

# Database Settings
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_PASSWORD=your_mysql_user_password

# Application Settings
PDNS_api_key=your_powerdns_api_key
PDNS_gmysql_password=your_powerdns_db_password

# Admin Application Settings
SECRET_KEY=your_powerdns_admin_secret
SQLALCHEMY_DATABASE_URI=postgresql://pdnsadmin:your_postgres_password@powerdns-admin-db-dev1/powerdnsadmin
PDNS_API_KEY=your_powerdns_api_key
PDNS_ADMIN_USERNAME=admin
PDNS_ADMIN_PASSWORD=admin

# Admin Database Settings
POSTGRES_PASSWORD=your_postgres_password
