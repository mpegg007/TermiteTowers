# Copy to ha-mcp.env, restrict its permissions, and replace all placeholders.
# This file is loaded only by infra/docker/ha-mcp-dev1.yml.

HOMEASSISTANT_URL=http://192.168.4.85:8123
HOMEASSISTANT_TOKEN=replace-with-dedicated-ha-mcp-user-long-lived-token
MCP_SECRET_PATH=/private_replace-with-a-random-url-safe-secret

# Start safely. Read-only mode blocks every write tool at the server.
READ_ONLY_MODE=true
REDACT_SECRETS=true
BACKUP_HINT=strong
# Automatic edit backups live in the compose bind mount.
HAMCP_BACKUP_DIR=/home/mcpuser/.ha-mcp/backups

# Keep experimental filesystem/YAML and developer capabilities disabled.
ENABLE_BETA_FEATURES=false
HAMCP_ENABLE_DEV_MODE=false
ENABLE_TOOL_SECURITY_POLICIES=true