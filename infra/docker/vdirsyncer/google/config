[general]
status_path = /cache/status/

[pair google_local]
a_sync = google_calendar
b_sync = local_calendar
twoway = true

[storage google_calendar]
type = google_calendar
client_id = ${GOOGLE_CLIENT_ID}
client_secret = ${GOOGLE_CLIENT_SECRET}
token_file = /config/google_token.json

[storage local_calendar]
type = caldav
url = http://radicale-dev1:5232/${GOOGLE_USER}/calendar/
username = ${GOOGLE_USER}
password = ${GOOGLE_PASSWORD}

# Shared family calendar (hosted locally)
[pair family_shared]
a_sync = local_family
b_sync = local_family_backup
twoway = true

[storage local_family]
type = caldav
url = http://radicale-dev1:5232/family/calendar/
username = family
password = ${FAMILY_PASSWORD}

[storage local_family_backup]
type = filesystem
path = /config/family_backup/
