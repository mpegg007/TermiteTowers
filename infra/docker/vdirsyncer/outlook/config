[general]
status_path = /cache/status/

[pair outlook_local]
a_sync = outlook_calendar
b_sync = local_calendar_outlook
twoway = true

[storage outlook_calendar]
type = outlook
client_id = ${OUTLOOK_CLIENT_ID}
client_secret = ${OUTLOOK_CLIENT_SECRET}
token_file = /config/outlook_token.json

[storage local_calendar_outlook]
type = caldav
url = http://radicale-dev1:5232/${OUTLOOK_USER}/calendar/
username = ${OUTLOOK_USER}
password = ${OUTLOOK_PASSWORD}

# Shared family calendar (hosted locally)
[pair family_shared]
a_sync = local_family
b_sync = local_family_backup
twoway = true

[storage local_family]
type = caldav
url = http://radicale-dev1:5232/family/calendar/
username = family
password = ${FAMILY_PASSWORD}

[storage local_family_backup]
type = filesystem
path = /config/family_backup/
