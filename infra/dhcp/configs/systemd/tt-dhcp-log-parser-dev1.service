[Unit]
Description=Parse DHCP logs to PostgreSQL (dev1)
After=postgresql.service kea-dhcp4-dev1.service
Wants=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/dev1/kea/scripts/monitoring/parse-kea-logs.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
