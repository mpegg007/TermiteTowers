[Unit]
Description=Kea DHCP-DDNS Server (dev1)
After=network.target

[Service]
ExecStart=/usr/sbin/kea-dhcp-ddns -c /etc/kea/tt-kea-dhcp-ddns-dev1.conf
Restart=on-failure
RestartSec=10
User=_kea
Group=_kea

[Install]
WantedBy=multi-user.target
