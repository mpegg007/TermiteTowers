[Unit]
Description=Kea Health Check HTTP Endpoint (dev1)
After=network.target kea-dhcp4-dev1.service

[Service]
Type=simple
User=mpegg-adm
Group=mpegg-adm
WorkingDirectory=/srv/dev1/kea/scripts/monitoring
ExecStart=/usr/bin/python3 /srv/dev1/kea/scripts/monitoring/tt-kea-health-http-dev1.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
