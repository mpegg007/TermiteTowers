[Unit]
Description=Run DHCP log parser every 10 minutes (dev1)
Requires=tt-dhcp-log-parser-dev1.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
AccuracySec=1min

[Install]
WantedBy=timers.target
