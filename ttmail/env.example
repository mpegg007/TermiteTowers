# ttmail - awmail for TermiteTowers
#
# Copy to `.env` in this directory and lock it down:
#    cp env.example .env && chmod 600 .env && "$EDITOR" .env
#
# These are awmail's own variable names. Nothing is renamed or remapped.

# --- Required by awmail (it refuses to build without all three) ------------
# The address mail is sent as.
AWMAIL_FROM=hal@termitetowers.ca

# THE BRIDGE PASSWORD - NOT your Proton account login password.
# Proton Mail Bridge -> account -> Mailbox details -> show bridge password.
AWMAIL_PASSWORD=

# Who you may write to. AN EMPTY VALUE IS A REFUSAL, not "send anywhere":
# awmail raises rather than defaulting to permissive.
#   *                     anyone (fine for a first test)
#   *@termitetowers.ca    one domain
#   me@example.com,you@example.com
AWMAIL_ALLOW=*

# --- Optional --------------------------------------------------------------
# Mailbox username, defaults to AWMAIL_FROM.
# AWMAIL_USER=hal@termitetowers.ca

# Transport: bridge (default, local Proton Bridge) or smtp.
# AWMAIL_TRANSPORT=bridge

# Bridge endpoint. monolith's bridge listens on loopback only.
# AWMAIL_HOST=127.0.0.1
# AWMAIL_PORT=1025          # SMTP: 1025 STARTTLS, 1026 implicit TLS
# AWMAIL_IMAP_PORT=1143     # IMAP, used by m.inbox()
# AWMAIL_SECURITY=starttls

# Only honoured for a loopback host; awmail refuses to relax verification
# anywhere else, so this cannot expose the password on the network.
# AWMAIL_VERIFY_TLS=false

# Rate caps live in awmail (defaults: 60/hour, 250/day, 25 recipients).
# Keep them; they are what stops a runaway loop from ruining a mailbox.
